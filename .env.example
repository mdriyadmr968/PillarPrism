# Google Gemini API Key (Required for Module 3 Content Synthesis & Hook Detection)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Faster-Whisper Model Tier (tiny, base, small, medium, large-v3, large-v3-turbo)
# Use 'base.en' or 'small.en' for CPU, 'medium' or 'large-v3-turbo' for CUDA GPU
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Workspace & Storage Directory
WORKSPACE_DIR=workspace

# Server Configuration
PORT=8000
HOST=0.0.0.0
